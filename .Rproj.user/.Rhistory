#Residuals plot
model <- lm(`Children without Health Insurance` ~ `Household Income ($)`, data = alldata_wider)
alldata_wider_res <- alldata_wider |>
mutate(
residual = resid(model),
dist_from_mean = abs(`Household Income ($)` - mean(`Household Income ($)`))
)
ggplot(alldata_wider_res, aes(x = `Household Income ($)`, y = residual)) +
geom_hline(yintercept = 0, color = "darkred", linetype = "dashed") +
geom_vline(aes(xintercept = mean(`Household Income ($)`)),
color = "lightblue", size = 1.5) +
geom_point(aes(size = dist_from_mean, color = dist_from_mean), alpha = 0.7) +
scale_color_gradient(low = "steelblue", high = "gray80",
name = "Distance from\nState Mean ($)") +
scale_size_continuous(range = c(1, 5), guide = "none") +
annotate("text",
x = mean(alldata_wider$`Household Income ($)`),
y = max(alldata_wider$residual),
label = "State Mean Income",
hjust = -0.1, color = "lightblue", fontface = "bold") +
labs(x = "Median Household Income ($)",
y = "Residual",
title = expression(bold("Residuals vs. Median Household Income")),
subtitle = "Point size and color fade with distance from state mean") +
theme_minimal()
ggplot(alldata_wider_cut, aes(x = income_bin, y = `Children without Health Insurance`)) +
geom_boxplot(aes(fill = income_bin == "65-77 (State Average)"), outlier.shape = NA, alpha = 0.5) +
scale_fill_manual(values = c("TRUE" = "red", "FALSE" = "lightblue"), guide = "none")+
geom_jitter(width = 0.15, color = "steelblue", size = 2.5, alpha = 0.3) +
labs(x = "Median Household Income Range ($k)",
y = "Proportion of Children Without Health Insurance",
title = expression(bold("Distribution of Uninsured Rate by Income Quintile")),
subtitle = "Colorado Counties") +
theme_minimal()
